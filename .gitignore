# Build outputs
**/bin/
**/obj/
# Rust binary source dirs (Cargo's `src/bin/` convention) must not be ignored.
!impl/rust/**/src/bin/
!impl/rust/**/src/bin/**

# NuGet pack output
artifacts/
*.nupkg
*.snupkg

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo

# OS
.DS_Store
Thumbs.db

# NIST KAT vector files (large, fetched on demand by scripts/fetch-nist-kat.sh)
test-vectors/nist-kat/*.rsp
test-vectors/nist-kat/*.req

