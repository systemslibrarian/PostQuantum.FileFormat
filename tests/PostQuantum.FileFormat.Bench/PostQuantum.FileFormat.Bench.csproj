<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Performance benchmarks for PQF. Console app, intentionally NOT in
    the test categorization: it runs in Release with optimizations on
    and is invoked explicitly. CI runs a smoke pass that just verifies
    the benchmark wiring still works; the published numbers in the
    README come from a manual run on a known machine.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PostQuantum.FileFormat.Bench</RootNamespace>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PostQuantum.FileFormat\PostQuantum.FileFormat.csproj" />
  </ItemGroup>

</Project>
